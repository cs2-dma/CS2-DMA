IDI_APPICON ICON "src/assets/app.ico"

#include "../../../../include/app/Core/build_info.h"
#include <winver.h>

1 VERSIONINFO
 FILEVERSION KEVQDMA_VERSION_NUMERIC
 PRODUCTVERSION KEVQDMA_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "KevqDMA\0"
            VALUE "FileDescription", "KevqDMA\0"
            VALUE "FileVersion", KEVQDMA_VERSION_STRING "\0"
            VALUE "InternalName", "KevqDMA\0"
            VALUE "OriginalFilename", "KevqDMA.exe\0"
            VALUE "ProductName", "KevqDMA\0"
            VALUE "ProductVersion", KEVQDMA_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

